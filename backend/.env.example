# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by FastAPI / SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/codersathi

# Sync URL used only by setup_db.py (psycopg2 driver)
SYNC_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/codersathi

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── AI API Keys ───────────────────────────────────────────────────────────────
# Get Gemini key free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Default model ─────────────────────────────────────────────────────────────
# Options: gemini-2.5-flash-lite | gemini-2.5-flash | groq/llama-3.3-70b-versatile
# See backend/agent/graph.py AVAILABLE_MODELS for full list
DEFAULT_MODEL=gemini-2.5-flash-lite

# ── MCP Server ────────────────────────────────────────────────────────────────
# Absolute path to the compiled devtoolkit-mcp dist/index.js
MCP_SERVER_PATH=C:/path/to/devtoolkit-mcp/dist/index.js

# ── Workspace ─────────────────────────────────────────────────────────────────
# Where agent workspaces are stored (relative or absolute)
WORKSPACE_BASE=./workspaces

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
